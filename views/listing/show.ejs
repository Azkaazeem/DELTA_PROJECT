<% layout('/layouts/boilerplate.ejs') %>
<div class="row mt-3"> 
    <div class="col-8 offset-2">
<body>
    <h3>Listing details</h3>
</div>
    <div class="class col-8 offset-2">
        <img src="<%= listing.image %>" class="card-img-top show-img" alt="listing_img"> 
        <div class="card-body"> 
            <p class="card-text">
                <b> <%= listing.title %> </b> <br>
                <%= listing.description %> <br>
                &#8360 <%= listing.price.toLocaleString("en-PK") %> <br>
                <%= listing.location %> <br>
                <%= listing.country %>
                <br> <br>
            </p>
        </div>
    </div>
    <br>
    <br>
    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-success col-1 offset-2">Edit</a>
        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE"> 
            <button class="btn btn-danger offset-2">Delete</button> 
        </form> 
    </div>
</body>
</div>