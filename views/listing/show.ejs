<link href="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.css" rel="stylesheet" />
<script src="https://unpkg.com/maplibre-gl@3.6.2/dist/maplibre-gl.js"></script>

<script>
    const mapToken = "<%= MAPTILER_API %>";
</script>

<% layout('/layouts/boilerplate.ejs') %>
    <div class="row mt-3">
        <div class="col-8 offset-2">
                <h3><b> <%= listing.title %> </b> <br></h3>
            </div>
            <div class="class col-8 offset-2">
                <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_img">
                <div class="card-body">
                    <p class="card-text">
                        <p><i><%= listing.owner ? listing.owner.username : "Anonymous" %></i></p>
                        <p><%= listing.description %></p>
                        <p>&#8360 <%= listing.price.toLocaleString("en-PK") %></p>
                        <p><%= listing.location %></p>
                        <p><%= listing.country %></p>
                    </p>
                </div>
                </div>
            </div>

            <div class="col-8 offset-2 mt-3 mb-3">
                <h3>Where you'll be</h3>
                <div id="map" style="height: 400px; width: 100%; border-radius: 10px;"></div>
            </div>
            <br>
            <br>
            <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
                <div class="btns">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-success col-1 offset-2">Edit</a>
                    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                        <button class="btn btn-danger offset-2">Delete</button>
                    </form>
                </div>
            <% } %>

            <div class="col-8 offset-3 mb-3">
                        <% if(currUser) { %>
                            <hr>
                            <h4>Leave a Review</h4>
                            <form action="/listings/<%= listing.id%>/reviews" method="POST" novalidate
                                class="need-validation">
                                <div class="mb-3 mt-3">
                                    <label for="rating" class="form-label">Rating</label>
                                    <fieldset class="starability-slot">
                                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                        <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                                        <label for="second-rate1" title="Terrible">1 star</label>
                                        <input type="radio" id="second-rate2" name="review[rating]" value="2" />
                                        <label for="second-rate2" title="Not good">2 stars</label>
                                        <input type="radio" id="second-rate3" name="review[rating]" value="3" />
                                        <label for="second-rate3" title="Average">3 stars</label>
                                        <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                                        <label for="second-rate4" title="Very good">4 stars</label>
                                        <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                                        <label for="second-rate5" title="Amazing">5 stars</label>
                                    </fieldset>
                                </div>
                                <div class="mb-3 mt-3">
                                    <label for="comment" class="form-label">Comment</label>
                                    <textarea rows="5" cols="107" id="comment" name="review[comment]" class="form-label"
                                        required></textarea>
                                    <div class="invalid-feedback">Please add some comment!</div>
                                </div>
                                <button class="btn btn-outline-dark">Submit</button>
                            </form>
                            <% } %>
            </div>

            <% if(listing.reviews.length > 0) { %>
                <div class="col-8 offset-2 mb-3">
                            <div class="row">
                                <hr>
                                <p><b>All reviews</b></p>
                                <% for(review of listing.reviews) { %>
                                    <div class="card col-5 ms-3 mb-3">
                                        <div class="card-body mt-3 mb-3 ms-3 me-3">
                                            <h5 class="card-title"> @<%= review.author.username %>
                                            </h5>
                                            <p class="card-text"> comment: <b><i><u>
                                                            <%= review.comment %>
                                                        </u></i></b> </p>
                                            <p class="starability-result card-text" data-rating="<%= review.rating %>">
                                            </p>
                                            <form method="post"
                                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                <button class="btn btn-sm btn-danger"><i class="fa-solid fa-trash"
                                                        style="color: rgb(255, 255, 255);"></i></button>
                                            </form>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                </div>
            <% } %>
    </div>

    <script src="/js/map.js"></script>