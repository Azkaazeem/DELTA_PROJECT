<% layout('/layouts/boilerplate.ejs') %>

<body>
    <br> <br>
    <h1>Create a new listing</h1>
    <br>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT"> 
        <div class="md-3">
            <label for="title" class="form-label">Title</label>
            <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control"/> <br />  <br />             
        </div>
        <div class="md-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control"><%= listing.description %></textarea> <br /> <br />  
        </div>
        <div class="md-3">
            <label for="image" class="form-label">Image</label>
            <input name="listing[image]" value="<%= listing.image %>" type="text" class="form-control"/> <br />  <br /> 
        </div>
        <div class="md-3">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control"/> <br />  <br /> 
        </div>
        <div class="md-3">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control"/> <br />  <br /> 
        </div>
        <div class="md-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control"/> <br />  <br /> 
        </div>
        <button class="add-btn">Edit</button>
        <br> <br>
    </form>
</body>
